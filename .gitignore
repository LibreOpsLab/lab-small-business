# --- Secrets & generated credentials ---
**/*.env
!**/*.env.example
**/secrets/
**/*.key
**/*.pem
!pki/openssl/*.cnf
**/vault_pass.txt
**/*.vault.yml
ansible/inventory/host_vars/*/vault.yml
!ansible/inventory/host_vars/*/vault.yml.example

# --- PKI generated material (never commit real key material) ---
pki/root-ca/private/
pki/root-ca/certs/*.pem
pki/root-ca/db/
pki/intermediate-ca/private/
pki/intermediate-ca/certs/*.pem
pki/intermediate-ca/db/
pki/issued/

# --- Terraform / state ---
**/.terraform/
**/*.tfstate
**/*.tfstate.backup
**/*.tfvars
!**/*.tfvars.example

# --- Docker ---
**/volumes/
**/data/postgres/
**/data/redis/
**/data/nextcloud/
**/data/mail/

# --- VMware Workstation artifacts ---
hypervisor/vms/**/*.vmdk
hypervisor/vms/**/*.nvram
hypervisor/vms/**/*.vmsd
hypervisor/vms/**/*.vmx.lck/
hypervisor/vms/**/*.log

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
.idea/

# --- VS Code: share extensions.json/settings.json, ignore personal machine-specific state ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Ansible ---
*.retry
ansible/collections/
ansible/roles/external/

# --- Federation (multi-business) ---
# Manifests contain WAN endpoints/topology; WireGuard client configs contain private keys.
# Both are meant to be exchanged out-of-band with partner businesses, never committed.
federation/registry/*.yaml
!federation/registry/.gitkeep
federation/wireguard-clients/*.conf
!federation/wireguard-clients/.gitkeep

# --- Provisioned business instances (output of scripts/provision-business.sh) ---
/*-lab/

# --- Class registry (optional federation layer) ---
federation/class-registry/ca/db/
federation/class-registry/bind/keys/
federation/class-registry/bind/zones/db.lab.internet
!federation/class-registry/bind/zones/db.lab.internet.seed
federation/class-registry-cert/
