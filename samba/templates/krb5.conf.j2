\
# {{ ansible_managed | default("Managed by ansible/roles/samba_ad and roles/sssd_client.") }}
# For the DC itself, prefer copying /var/lib/samba/private/krb5.conf (generated by
# samba-tool domain provision) instead of hand-writing this — this template is for
# non-DC domain members that need a krb5.conf without running Samba's provisioning.

[libdefaults]
    default_realm = {{ lab_realm | default('LAB.LOCAL') }}
    dns_lookup_realm = false
    dns_lookup_kdc = true
    ticket_lifetime = 24h
    renew_lifetime = 7d
    forwardable = true
    rdns = false

[realms]
    {{ lab_realm | default('LAB.LOCAL') }} = {
        kdc = {{ samba_dc_fqdn | default('samba-dc01.lab.local') }}
        admin_server = {{ samba_dc_fqdn | default('samba-dc01.lab.local') }}
        default_domain = {{ lab_domain | default('lab.local') }}
    }

[domain_realm]
    .{{ lab_domain | default('lab.local') }} = {{ lab_realm | default('LAB.LOCAL') }}
    {{ lab_domain | default('lab.local') }} = {{ lab_realm | default('LAB.LOCAL') }}
