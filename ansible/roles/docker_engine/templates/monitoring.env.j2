# {{ ansible_managed }}
# See docker/monitoring/.env.example.

GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}
# The salt is derived from the user name so the hash is stable between runs. A random salt would
# rewrite this file every run and restart Loki each time. Needs passlib and bcrypt on the controller.
LOKI_PUSH_USERS='{{ loki_push_user }}:{{ loki_push_password | password_hash("bcrypt", (loki_push_user ~ "-lab-loki-salt") | hash("sha256") | truncate(22, True, "")) }}'
