---
# Copy to vault.yml and encrypt with: ansible-vault encrypt vault.yml

join_domain_user: "administrator"
join_domain_password: "changeme-strong-password"
dovecot_ldap_bind_pass: "changeme-svc-dovecot-password"
postfix_ldap_bind_pass: "changeme-svc-postfix-password"

# Generate each with: openssl rand -base64 32
nextcloud_db_root_pass: "changeme-generate-with-openssl-rand"
nextcloud_db_pass: "changeme-generate-with-openssl-rand"
nextcloud_admin_password: "changeme-strong-password"
onlyoffice_jwt_secret: "changeme-generate-with-openssl-rand"
wordpress_db_root_pass: "changeme-generate-with-openssl-rand"
wordpress_db_pass: "changeme-generate-with-openssl-rand"
wordpress_admin_password: "changeme-strong-password"
