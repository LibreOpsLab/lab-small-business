# Copy to .env and fill in real values. Never commit the real .env (see .gitignore).
# Generate secrets with: openssl rand -base64 36

AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_DB=authentik
AUTHENTIK_PG_PASS=changeme-generate-with-openssl-rand

# Django secret key - must be long and random.
AUTHENTIK_SECRET_KEY=changeme-generate-with-openssl-rand

# Bootstrap superuser (akadmin) - the break-glass account that works even if the Samba AD
# LDAP source is unreachable. See docs/AuthentikAdmin.md#recovery-procedures.
AUTHENTIK_BOOTSTRAP_PASSWORD=changeme-strong-password
AUTHENTIK_BOOTSTRAP_TOKEN=changeme-generate-with-openssl-rand
