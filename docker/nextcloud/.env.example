# Copy to .env and fill in real values. Never commit the real .env (see .gitignore).

NEXTCLOUD_DB_ROOT_PASS=changeme-generate-with-openssl-rand
NEXTCLOUD_DB_PASS=changeme-generate-with-openssl-rand
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud

NEXTCLOUD_ADMIN_USER=nc-admin
NEXTCLOUD_ADMIN_PASSWORD=changeme-strong-password

# Populated automatically by authentik/scripts/bootstrap-authentik.sh from the OIDC
# provider blueprint (authentik/blueprints/oidc-nextcloud.yaml) - leave as placeholders
# if running bootstrap-authentik.sh --sync-secrets, which rewrites this file in place.
NEXTCLOUD_OIDC_CLIENT_ID=changeme
NEXTCLOUD_OIDC_CLIENT_SECRET=changeme

# ONLYOFFICE connector (docker/onlyoffice) - internal Docker network address, not the
# public docs.lab.local hostname, so NextCloud talks to it directly rather than via Traefik.
ONLYOFFICE_INTERNAL_URL=http://onlyoffice-documentserver
ONLYOFFICE_JWT_SECRET=changeme-generate-with-openssl-rand
