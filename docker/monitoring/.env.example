# Copy to .env and fill in real values. Never commit the real .env (see .gitignore).
# Ansible renders this from host_vars/docker01/vault.yml (grafana_admin_password).

# Grafana's local break-glass admin. Day-to-day access is SSO through Authentik.
# Generate with: openssl rand -base64 32
GRAFANA_ADMIN_PASSWORD=changeme-strong-password
