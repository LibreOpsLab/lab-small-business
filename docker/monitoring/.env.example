# Copy to .env and fill in real values. Never commit the real .env (see .gitignore).
# Ansible renders this from host_vars/docker01/vault.yml (grafana_admin_password,
# loki_push_user, loki_push_password).

# Grafana's local break-glass admin. Day-to-day access is SSO through Authentik.
# Generate with: openssl rand -base64 32
GRAFANA_ADMIN_PASSWORD=changeme-strong-password

# Address pfSense syslog (UDP and TCP 1514) is accepted on. Keep it the LAN address of docker01.
SYSLOG_BIND_ADDRESS=10.10.10.20

# Who may push logs to Loki: htpasswd format, user:bcrypt-hash. Keep the single quotes, so the
# dollar signs in the hash are not expanded. Generate with:
#   htpasswd -nbB lab-logs 'the-push-password'
LOKI_PUSH_USERS='lab-logs:$2y$05$replace-with-an-htpasswd-bcrypt-hash'
