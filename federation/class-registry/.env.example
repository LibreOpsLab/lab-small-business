# Copy to .env — scripts/init-registry.sh does this automatically and fills in a generated
# token + your --ns-ip. Never commit the real .env (see .gitignore).

CLASS_ROOT_DOMAIN=lab.internet
CLASS_REGISTRY_TOKEN=changeme-generate-with-openssl-rand-hex-16
ZONE_NS_IP=changeme-this-hosts-reachable-ip
